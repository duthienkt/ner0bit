# Token bí mật — điền đúng giá trị này vào ô Token ở portal của thiết bị.
NER0BIT_TOKEN=doi-thanh-chuoi-ngau-nhien-dai
# MAC thiết bị (12 hex, chữ thường) — xem dòng "[net] task start, id=..." trong Serial log. Trống = nhận mọi id.
NER0BIT_DEVICE_ID=
# Mật khẩu giao diện web (mở URL server bằng trình duyệt). Trống = tắt UI.
# UI sửa được lịch, tức điều khiển được bơm: dùng chuỗi dài ngẫu nhiên, khác NER0BIT_TOKEN
# (vd. `openssl rand -base64 18`). Đổi mật khẩu ⇒ mọi phiên đăng nhập cũ hết hiệu lực.
NER0BIT_UI_PASSWORD=
# 1 = lấy IP client từ header CF-Connecting-IP (giới hạn đăng nhập sai theo IP). CHỈ bật khi server
# chỉ nhận request qua Cloudflare Tunnel; mở port trực tiếp thì client tự giả được header này.
NER0BIT_TRUST_CF_HEADER=
# Đường dẫn file SQLite (lịch, sổ tưới, mưa, sự kiện). Trống = $NER0BIT_DATA_DIR/ner0bit.db.
NER0BIT_DB=
